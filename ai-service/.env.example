# TruthLens AI Microservice Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Search Providers: duckduckgo, mock, serper, tavily
SEARCH_PROVIDER=duckduckgo
SERPER_API_KEY=
TAVILY_API_KEY=
MAX_SEARCH_RESULTS=6
SEARCH_TIMEOUT=8

# LLM Providers: fallback, gemini, openai, ollama
LLM_PROVIDER=fallback
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Internal API Secret for backend-to-microservice auth
INTERNAL_API_SECRET=dev-secret-internal-truthlens

# Embeddings: tfidf (fast, built-in) or sentence_transformers
EMBEDDING_BACKEND=tfidf
